# ===================================================================
# HUGH - By Matthew Taraschke - 2026
#
# Load this file before starting Hugh:
#   source ./granite.env
#
# ===================================================================


# -------------------------------------------------------------------
# 01. Model loading and GPU configuration
# -------------------------------------------------------------------

# Local model directory. Preserve the working model and quantization.
export MODEL_ID="$HOME/models/granite-4.2-8b"

# Optional model revision/pin. Empty uses the default/local model.
export MODEL_REVISION=""

# Do not execute custom model code downloaded from a model repository.
export TRUST_REMOTE_CODE=0

# Load model weights using the application's existing 4-bit NF4 setup.
export LOAD_IN_4BIT=1

# Transformers generation/KV-cache implementation.
# Empty keeps its default behavior. This is NOT the attachment/web cache.
export CACHE_IMPLEMENTATION=""

# PyTorch CUDA allocator configuration; does not change token limits.
export PYTORCH_CUDA_ALLOC_CONF="expandable_segments:True"


# -------------------------------------------------------------------
# 02. General context, thinking, and ordinary chat generation
# -------------------------------------------------------------------

# Native context: 131,072 tokens.
# Largest general generation allowance:
#   120,832 input + 10,240 generated = 131,072.
#
# Do not increase these independently beyond the native context window.
# Valid token limits do not guarantee sufficient GPU/CPU memory.
#
# Research writing and support review use smaller input allowances
# defined later in this file.
export MAX_INPUT_TOKENS=118784

# Ordinary chat output ceilings, by thinking mode.
# When thinking is enabled, reasoning and final answer share this budget.
# Research generation is additionally capped by WEB_SYNTH_* settings.
export MAX_NEW_TOKENS=4096
export THINKING_LOW_MAX_NEW_TOKENS=6144
export THINKING_MAX_NEW_TOKENS=8192

# Default thinking mode: off | low | full.
# Per-turn overrides:
#   @nothink   Off
#   @thinklow  Genuine low-effort thinking
#   @think     Full thinking
export THINKING_MODE="off"

# Legacy fallback used only when THINKING_MODE is empty.
# The explicit THINKING_MODE above takes precedence.
export ENABLE_THINKING=0

# Display reasoning during ordinary streamed thinking responses.
# This does not enlarge the reasoning budget or enable thinking.
export SHOW_THINKING=1

# Sampling controls for ordinary, non-deterministic generation.
# Research phases currently request deterministic generation, so these
# are not the controls to adjust for longer research reports.
export TEMPERATURE=0.986
export TOP_P=0.94
export TOP_K=50


# -------------------------------------------------------------------
# 03. Research answers - output length and structured-answer limits
#
# These are the main controls for report length.
#
# Effective research generation ceiling:
#   Thinking off:
#     min(MAX_NEW_TOKENS, WEB_SYNTH_MAX_NEW_TOKENS)
#   Thinking low/full:
#     min(the mode's general output limit,
#         WEB_SYNTH_THINKING_MAX_NEW_TOKENS)
#
# With this configuration:
#   Off: 5,120 tokens | Low: 5,120 tokens | Full: 10,240 tokens
#
# Time limits, available evidence, and validation can still result in
# a shorter or partial answer.
# -------------------------------------------------------------------

# Constrained JSON decoding for supported thinking-off research steps.
# Never applied to Granite's active thinking channel.
# This controls structure, not factual correctness.
export WEB_JSON_CONSTRAINED=1

# Generated-token allowance for thinking-off research drafts/recovery.
export WEB_SYNTH_MAX_NEW_TOKENS=5120

# Generated-token allowance for research drafts with thinking enabled.
# Includes reasoning as well as the final structured answer.
export WEB_SYNTH_THINKING_MAX_NEW_TOKENS=10240

# Maximum model-generated structured research items.
# Effective item cap is min(WEB_GUIDED_MAX_ITEMS, WEB_MAX_ANSWER_BLOCKS).
# This permits up to 12 items; it does not require 12.
export WEB_GUIDED_MAX_ITEMS=12
export WEB_MAX_ANSWER_BLOCKS=16

# Finding/interpretation length requested by the research prompt and
# enforced by the thinking-off JSON schema when constraints are enabled.
export WEB_GUIDED_FINDING_MAX_CHARS=1200

# Separate validation ceiling for each finding/interpretation.
# Keep this at least as large as WEB_GUIDED_FINDING_MAX_CHARS.
export WEB_MAX_CLAIM_CHARS=2000

# Maximum logical external-source references per structured item.
# One logical source can contain several supporting passages.
export WEB_MAX_REFERENCES_PER_BLOCK=3

# Thinking-off JSON-schema limit for requested generated code examples.
# CODE_CHECK_MAX_CHARS below supplies an additional validation limit.
export WEB_GUIDED_CODE_MAX_CHARS=6000


# -------------------------------------------------------------------
# 04. Research evidence - what the report-writing model receives
#
# Fetching/indexing a page does not mean all of it reaches synthesis.
# These settings control the smaller selection used to write the answer.
#
# In the supplied Stage 3.2 code, selected cards are also capped at
# three per canonical URL. That particular limit is hard-coded in Python.
# -------------------------------------------------------------------

# Input allowance for the research-writing prompt, including instructions,
# source metadata, local targets, and selected external passages.
# The application reserves some room within this allowance for recovery.
export WEB_SYNTH_MAX_INPUT_TOKENS=16384

# Maximum selected passage cards before grouping/overlap merging.
# Relevant local attachment targets can also occupy card slots.
export WEB_SYNTH_MAX_CARDS=24

# Maximum tokens per individual evidence-card window.
# Larger windows retain more surrounding context.
export WEB_SYNTH_CARD_TOKENS=384

# Normal target for pages with successfully delivered evidence.
# In the current code, requests containing terms such as "comprehensive"
# or "in-depth" raise the target to MAX_WEB_PAGES_PER_TURN.
# This setting does not expand @url beyond its supplied document.
export WEB_TARGET_PAGES=4

# Hard ceiling on stored web documents in a research turn.
export MAX_WEB_PAGES_PER_TURN=6

# Additional retrieval from ALREADY INDEXED WEB DOCUMENTS.
# Despite "LOCAL" in the name, this does not mean local attachments.
# These reads do not make new network requests.
# Other time, tool-call, and evidence budgets still apply.
export WEB_SYNTH_LOCAL_READS=8


# -------------------------------------------------------------------
# 05. Research timing and recovery
#
# Gathering and finalization have separate overall budgets.
# Individual phases can be shortened by the time remaining or by time
# reserved for later work. Cancellation is cooperative between steps.
# -------------------------------------------------------------------

# Overall public-evidence gathering budget, including optional auto-query
# formulation, searching, fetching, and indexed-section retrieval.
export WEB_TOTAL_TIMEOUT=360

# Overall answer-finalization budget:
# context preparation, drafting, recovery, support review, and code checks.
# This is NOT an allowance of 480 seconds for each individual phase.
export WEB_FINALIZATION_TIMEOUT=480

# Maximum time allocated to the first research draft.
export WEB_SYNTH_DRAFT_TIMEOUT=240

# Maximum time allocated to a thinking-off corrected answer.
# Recovery uses the same evidence; it does not initiate fresh research.
export WEB_SYNTH_REPAIR_TIMEOUT=90

# Stage 3.2 behavior:
#   1  = initial draft only.
#   >1 = initial draft plus at most ONE recovery attempt.
# Keeping 3 preserves the existing value; it does not mean three drafts.
export MAX_WEB_FINALIZATION_ROUNDS=3

# Time protected for support review while budgeting draft/recovery.
# This comes from WEB_FINALIZATION_TIMEOUT, not an additional allowance.
# The effective reservation is also bounded by WEB_VERIFY_TIMEOUT.
export WEB_REVIEW_RESERVE_SECONDS=90


# -------------------------------------------------------------------
# 06. Research support review and generated-code checks
# -------------------------------------------------------------------

# Use the SAME LOCAL Granite model, with thinking off, to assess whether
# supplied external passages support the proposed findings.
#
# This is not an external model service, independent fact verification,
# or a guarantee of correctness.
#
# Keeping this enabled preserves the additional support-review step.
export WEB_VERIFY_CLAIMS=1

# Maximum support-review prompt size.
# Supporting passages can be repeated across findings, so a long report's
# review prompt can be larger than its original synthesis prompt.
# This is a ceiling, not a request to fill the entire allowance.
export WEB_VERIFY_MAX_INPUT_TOKENS=65536

# Maximum generated tokens for the review's structured response.
export WEB_VERIFY_MAX_NEW_TOKENS=1024

# Per-review time limit, additionally bounded by finalization time left.
export WEB_VERIFY_TIMEOUT=90

# Compile proposed Python examples in structured research answers for
# syntax checking under the server's Python version.
# Proposed code is NEVER executed by this check.
# This does not syntax-check every ordinary streamed response.
export CODE_SYNTAX_CHECKS=1

# Time limit for each isolated syntax-check worker.
export CODE_CHECK_TIMEOUT=3

# Maximum generated code size accepted by the code-checking path.
export CODE_CHECK_MAX_CHARS=200000


# -------------------------------------------------------------------
# 07. Public web search and optional @autoweb query formulation
#
# @web / @search: snippets only.
# @research:     search, then selected static documents.
# @autoweb:      optionally formulate one initial public query, then
#               perform bounded static-document research.
#
# The active Stage 3.2 routine gatherer normally issues one search query.
# Raising a search ceiling does not make it schedule additional queries.
#
# Public task/query text can be sent to search providers.
# Do not put secrets in public queries.
# -------------------------------------------------------------------

export WEB_SEARCH_ENABLED=1

# The currently supported search provider.
export WEB_SEARCH_PROVIDER="ddgs"

# Backend fallback order for search attempts.
# A backend can fail or return no usable results.
export WEB_SEARCH_BACKENDS="auto,bing,duckduckgo"

# Provider search region and content-filter preference.
export WEB_SEARCH_REGION="us-en"
export WEB_SEARCH_SAFESEARCH="moderate"

# Maximum results requested/registered for one logical search.
# More results provide more candidates; they are not all necessarily
# fetched or delivered to synthesis.
export WEB_MAX_RESULTS=8

# Maximum characters in a public search query.
export MAX_WEB_QUERY_CHARS=500

# Timeout for an individual DDGS backend attempt, not the whole turn.
export WEB_SEARCH_TIMEOUT=15

# Safety ceiling on logical searches in one turn.
# Backend retries are distinct from scheduling additional logical queries.
export MAX_WEB_SEARCHES_PER_TURN=4

# Additional delivered-evidence ceiling for snippet-only source scope
# (@web/@search and corresponding cached follow-ups).
# This is NOT the output-token limit for full research reports.
export MAX_WEB_TOKENS=8192

# Optional small LOCAL model step to formulate the initial @autoweb query.
# It receives public task/context, not private attachment contents.
# Seeded @research, @url, and cached gathering do not use this planner.
export WEB_AUTO_QUERY_MODEL=1

# Output and time ceilings for that optional query-formulation step.
export WEB_AUTO_QUERY_MAX_NEW_TOKENS=128
export WEB_AUTO_QUERY_TIMEOUT=15


# -------------------------------------------------------------------
# 08. Web tool calls and delivered-evidence budgets
#
# These govern source delivery, not final answer length.
# Tool calls, HTTP requests, indexed text, and synthesis cards are
# different things and have separate limits.
# -------------------------------------------------------------------

# Shared allowance for search/open/read operations.
# One operation can involve multiple HTTP requests or no network request.
export MAX_WEB_TOOL_CALLS_PER_TURN=16

# Maximum tokens in one delivered evidence-bearing tool payload.
# Serialized metadata/JSON overhead also consumes this allowance.
export MAX_WEB_TOOL_RESULT_TOKENS=4096

# Aggregate delivered web-tool evidence allowance per turn.
# Snippet-only scope additionally applies MAX_WEB_TOKENS above.
export MAX_WEB_TOTAL_TOOL_RESULT_TOKENS=32768


# -------------------------------------------------------------------
# 09. Static fetching, document chunking, and web PDFs
#
# Static research does not execute JavaScript, log in, bypass access
# restrictions, or recursively crawl arbitrary links.
# -------------------------------------------------------------------

# Enable static-document research modes.
export WEB_RESEARCH_ENABLED=1

# Enable actual document fetching; separate from search availability.
export WEB_FETCH_ENABLED=1

# Time limit for an individual HTTP fetch attempt.
export WEB_FETCH_TIMEOUT=15

# Maximum redirects followed within one fetch chain.
export WEB_FETCH_MAX_REDIRECTS=5

# Ordinary non-PDF response-body limit: 1 MiB.
# Enabled PDFs have separate PDF-specific byte limits in the application.
export WEB_FETCH_MAX_PAGE_BYTES=1048576

# Aggregate charged download allowance: 10 MiB per research turn.
# Includes relevant robots, redirect, retry, and failed-fetch accounting.
export WEB_FETCH_MAX_TOTAL_BYTES=10485760

# Cumulative delivered excerpt-text allowance per web document.
# This is not the size of the retained page index or the final answer.
export WEB_FETCH_MAX_PAGE_TOKENS=16384

# Indexed web-document chunk size and overlap, in tokens.
# Overlap must remain smaller than chunk size.
export WEB_PAGE_CHUNK_TOKENS=800
export WEB_PAGE_CHUNK_OVERLAP=64

# Number of relevant chunks initially selected when opening a document.
# These are not necessarily the first two chunks in document order.
export WEB_PAGE_INITIAL_CHUNKS=2

# Maximum chunks for initial delivery/read_page calls.
# find_in_page has its own match limit below.
export WEB_PAGE_MAX_CHUNKS_PER_CALL=3

# Maximum matching chunks requested by a find_in_page call.
export WEB_FIND_MAX_MATCHES=5

# Enable text extraction from web PDFs.
# Independent of FILE_PDF_ENABLED and local attachment OCR.
# Scanned web PDFs do not receive the local OCR treatment.
# Unlisted web-PDF byte/page/text/time settings retain application defaults
# unless separately supplied in the environment.
export WEB_PDF_ENABLED=1


# -------------------------------------------------------------------
# 10. Web-fetch destination, robots, and proxy policy
#
# These are security/access-policy controls, not report-detail controls.
# -------------------------------------------------------------------

# Honor robots.txt restrictions.
export WEB_RESPECT_ROBOTS=1

# 0 = permit fetching when robots.txt is unavailable, where other policy
#     checks allow it.
# 1 = refuse fetching when robots policy cannot be established.
# This does not override an explicit robots disallow rule.
export WEB_ROBOTS_FAIL_CLOSED=0

# 0 blocks non-public destinations such as loopback, LAN, and link-local
# addresses. This does not restrict permitted local @file attachments.
export WEB_ALLOW_PRIVATE_ADDRESSES=0

# 0 permits only ports 80 and 443 for web destinations.
export WEB_ALLOW_NONSTANDARD_PORTS=0

# 0 ignores proxy environment variables for these workers.
# Enabling trusted proxies changes upstream resolution/trust assumptions.
export WEB_TRUST_ENV_PROXY=0

# HTTP identity and robots user-agent matching.
# Preserved from the working configuration.
export WEB_USER_AGENT="HUGH/1.0 (local static research assistant)"


# -------------------------------------------------------------------
# 11. Session-local public research snapshot cache
#
# Recognized related ordinary follow-ups can reuse retained sources.
# Cached follow-ups make no network requests.
# Use an explicit web directive when additional/fresh research is wanted.
#
# Snapshots are in memory, not a persistent disk research index.
# Retention time is not a guarantee of source freshness.
# -------------------------------------------------------------------

export WEB_CACHE_ENABLED=1

# Maximum retained public research snapshots.
export WEB_CACHE_MAX_SNAPSHOTS=4

# Cache cost allowance: source text plus metadata accounting.
# Not an exact process-RAM limit.
export WEB_CACHE_MAX_CHARS=8000000

# Retention from snapshot creation: 1,800 seconds = 30 minutes.
# Reuse retains original source retrieval timestamps.
export WEB_CACHE_TTL_SECONDS=1800


# -------------------------------------------------------------------
# 12. Local attachment access and source-file limits
# -------------------------------------------------------------------

# Permitted local roots; use colon-separated paths on this Linux setup.
# Resolved/opened destinations must remain within a permitted root.
export FILE_ALLOWED_ROOTS="$HOME"

# Permitted suffixes. Continuation backslashes keep this one value.
# Listing a suffix does not remove its extractor/dependency requirements.
export ALLOWED_FILE_SUFFIXES="\
.txt,.md,.rst,.log,.csv,.tsv,.json,.jsonl,.ndjson,\
.yaml,.yml,.toml,.ini,.cfg,.conf,.env,.properties,\
.xml,.html,.htm,.css,.scss,.sql,\
.py,.pyw,.sh,.bash,.zsh,.fish,.ps1,\
.js,.mjs,.cjs,.jsx,.ts,.tsx,.vue,.svelte,\
.c,.h,.cc,.cpp,.hpp,.cs,.java,.go,.rs,.rb,.php,.pl,.r,\
.patch,.diff,.service,.socket,.timer,.desktop,\
.pdf,.docx,.xlsx,.pptx,.odt,.ods,.odp,.rtf,\
.png,.jpg,.jpeg,.tif,.tiff,.bmp,.webp,.gif,\
.bashrc,.profile,.gitignore,.dockerignore"

# Permit extensionless text attachments, subject to other checks.
# This does not enable arbitrary binary-file interpretation.
export FILE_ALLOW_EXTENSIONLESS=1

# Maximum explicit attachments in one request.
export MAX_FILES_PER_TURN=4

# Source-file byte limits: 20 MiB per file; 40 MiB combined per turn.
# Oversized source files are rejected, not truncated before parsing.
export MAX_FILE_BYTES=20971520
export MAX_TOTAL_FILE_BYTES=41943040

# Optional explicit fallback text encoding.
# Empty does not disable normal BOM/declared/UTF-8 handling or available
# heuristic detection. Set a known encoding only when needed.
export FILE_FALLBACK_ENCODING=""


# -------------------------------------------------------------------
# 13. Local extraction, prepared context, and attachment snapshots
#
# Prepared attachment context and research synthesis are separate:
# research subsequently selects smaller cards from prepared excerpts.
# A large attachment allowance does not imply a complete-file audit.
# -------------------------------------------------------------------

# Prepared attachment-context allowances: per file and combined.
export MAX_FILE_TOKENS=65536
export MAX_TOTAL_FILE_TOKENS=65536

# Local attachment chunk size; separate from web chunks/evidence cards.
export FILE_CHUNK_TOKENS=1200

# Headroom retained when budgeting attachment context.
# This is not an output-token limit. Web evidence is reserved separately.
export FILE_CONTEXT_RESERVE_TOKENS=8192

# Maximum extracted characters and sections per attachment.
export FILE_EXTRACT_MAX_CHARS=1000000
export FILE_MAX_SECTIONS=4096

# Per-extraction worker timeout and aggregate preparation budget.
export FILE_EXTRACT_TIMEOUT=45
export FILE_TOTAL_TIMEOUT=120

# Isolated worker address-space limit: 1,024 MiB.
# This is not GPU memory or a whole-application RAM limit.
# Worker resource limits are not a complete operating-system sandbox.
export FILE_WORKER_MEMORY_MB=1024

# In-memory extracted attachment snapshots.
# Ordinary attachment follow-ups reuse snapshots; explicit @file rereads
# the source. /clear discards retained snapshots.
export FILE_CACHE_MAX_DOCUMENTS=12

# Cache cost allowance includes extracted text/chunks and metadata.
# Not an exact process-RAM limit.
export FILE_CACHE_MAX_CHARS=8000000


# -------------------------------------------------------------------
# 14. Local PDF, Office, table, and archive extraction
#
# Text/data extraction does not reproduce complete visual layout.
# Spreadsheet formulas are read as stored and are never calculated.
# Macros, embedded programs, and external resources are not executed.
# Legacy/encrypted Office and encrypted PDF files remain unsupported.
# -------------------------------------------------------------------

# Local PDFs: eligible extraction is limited to the first 100 pages.
export FILE_PDF_ENABLED=1
export FILE_PDF_MAX_PAGES=100

# Modern Office/OpenDocument extraction.
export FILE_OFFICE_ENABLED=1

# Workbook/table limits.
export FILE_MAX_SHEETS=16
export FILE_MAX_ROWS=2000
export FILE_MAX_COLS=80

# Total cell allowance within one attachment, across its sheets/records.
export FILE_MAX_CELLS=50000

# PowerPoint/OpenDocument presentation slide limit.
export FILE_MAX_SLIDES=100

# XLSX shared-string table limit.
export FILE_MAX_SHARED_STRINGS=100000

# Office/OpenDocument ZIP-container safety limits.
export FILE_ZIP_MAX_MEMBERS=2048
export FILE_ZIP_MAX_MEMBER_BYTES=16777216
export FILE_ZIP_MAX_UNCOMPRESSED_BYTES=67108864
export FILE_ZIP_MAX_RATIO=200

# Above byte limits:
#   Per member:              16 MiB
#   Total uncompressed:      64 MiB
#   Maximum compression ratio: 200x


# -------------------------------------------------------------------
# 15. Local OCR - enabled
#
# Images require Pillow and the system tesseract executable.
# Scanned local PDF pages additionally require PyMuPDF.
# PDF OCR is attempted only where native text extraction gives no text.
#
# OCR recognizes text; it is not visual image understanding.
# Overall extraction/preparation time limits still apply.
# -------------------------------------------------------------------

export FILE_OCR_ENABLED=1

# Installed Tesseract recognition language(s).
export FILE_OCR_LANGUAGE="eng"

# PDF rasterization resolution and Tesseract DPI hint.
export FILE_OCR_DPI=150

# Maximum pixels per eligible image/frame or rendered PDF page.
export FILE_OCR_MAX_PIXELS=16000000

# Maximum frames from a multi-frame image; not a PDF-page limit.
export FILE_OCR_MAX_FRAMES=4

# Tesseract timeout for an individual OCR invocation.
export FILE_OCR_TIMEOUT=20


# -------------------------------------------------------------------
# 16. Chat logging and diagnostic privacy
#
# Disabling expanded-source logging does not make logs source-free:
# user requests, assistant answers, quotations, paths, and some errors
# can still contain private/source information.
# -------------------------------------------------------------------

# Append-only chat log. Must be a regular file, not a symbolic link.
export CHAT_LOG="$HOME/granite-hugh/chatlog.txt"

# 0 avoids explicitly logging complete expanded source contexts/tool text.
export LOG_SOURCE_CONTENT=0

# Raw generation diagnostics can expose reasoning and private source text.
# Leave disabled for normal use.
export GENERATION_DEBUG=0
export WEB_TOOL_DEBUG=0


# -------------------------------------------------------------------
# 17. Interactive prompt editor and editing history
#
# Prompt-editing history is separate from conversation/source snapshots
# and from CHAT_LOG. /clear does not erase these on-disk logs/history.
# -------------------------------------------------------------------

# Persist typed prompt-editing history between sessions.
export PROMPT_HISTORY_ENABLED=1
export PROMPT_HISTORY_FILE="$HOME/.local/state/hugh/prompt_history"

# Display the editor shortcut toolbar.
export PROMPT_BOTTOM_TOOLBAR=1

# Allow multiline editing: Enter submits; Ctrl+O inserts a newline.
export PROMPT_MULTILINE=1


# -------------------------------------------------------------------
# 18. Older/compatibility settings - not active Stage 3.2 tuning knobs
#
# Retained from the existing file, with their existing values.
# These names are accepted by Config, but the current Stage 3.2 routine
# gatherer/card-synthesis path does not use them as described below.
# -------------------------------------------------------------------

# Used by the older round-based gathering controller.
# Does not make the current deterministic gatherer run ten rounds.
export MAX_WEB_TOOL_ROUNDS=10

# Older controller's no-progress/recovery threshold.
# Does not switch the current Stage 3.2 gatherer between planner modes.
export WEB_MAX_NO_PROGRESS_ROUNDS=2

# These quote-limit settings do not control active Stage 3.2 card sizing.
# Use WEB_SYNTH_CARD_TOKENS for evidence-card window size.
export WEB_MAX_QUOTE_TOKENS=256
export WEB_MIN_QUOTE_CHARS=12